# Copie para .env e preencha. O .env nunca vai para o git.

# Postgres (Neon). Formato:
# jdbc:postgresql://<host>/<banco>?sslmode=require
TRADUGIRIA_DB_URL=jdbc:postgresql://localhost:5432/tradugiria
TRADUGIRIA_DB_USUARIO=tradugiria
TRADUGIRIA_DB_SENHA=

# Camada de IA (nivel 4 da cascata). Sem a chave, a API opera
# normalmente nos niveis 0 a 2 e apenas nao resolve termos desconhecidos.
ANTHROPIC_API_KEY=
