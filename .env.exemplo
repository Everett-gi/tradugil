# Copie para .env e preencha. O .env nunca vai para o git.

# --------------------------------------------------------------- Banco

# Postgres (Neon). Formato:
# jdbc:postgresql://<host>/<banco>?sslmode=require
TRADUGIRIA_DB_URL=jdbc:postgresql://localhost:5432/tradugiria
TRADUGIRIA_DB_USUARIO=tradugiria
TRADUGIRIA_DB_SENHA=

# ----------------------------------------------------------- Seguranca

# Chave de assinatura do access token. Minimo 32 bytes.
# Gere uma com:  openssl rand -base64 48
#
# Sem esta variavel a aplicacao sobe com uma chave aleatoria da execucao,
# o que serve para desenvolvimento -- mas em producao significa que toda
# reinicializacao desloga todo mundo.
TRADUGIRIA_JWT_SEGREDO=

# ------------------------------------------------------------------ IA

# Camada de IA (nivel 4 da cascata). Sem a chave, a API opera normalmente
# nos niveis 0 a 2 e apenas nao resolve termos desconhecidos.
ANTHROPIC_API_KEY=
