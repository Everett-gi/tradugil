# Credenciais da chave que assina o APK de release.
#
# COPIE PARA keystore.properties E PREENCHA. O arquivo com as senhas nunca
# vai para o git: keystore.properties esta no .gitignore, junto com o
# proprio *.jks.
#
# Sem este arquivo, o build de release ainda funciona e gera um APK sem
# assinatura. Serve para conferir que compila, e nao para distribuir: o
# Android recusa instalar APK sem assinatura.

# Caminho do keystore, relativo a pasta android/.
storeFile=tradugil.jks

# A senha que voce digitou ao gerar a chave com o keytool.
storePassword=

# O apelido informado no comando (-alias tradugil).
keyAlias=tradugil

# A senha da chave. Se o keytool nao pediu uma segunda senha, e a mesma do
# storePassword: repita o mesmo valor aqui.
keyPassword=
