# Borda do Tradugil.
#
# O Caddy resolve tres coisas de uma vez, e por isso substitui a dupla
# nginx + certbot: TLS automatico com renovacao, proxy reverso e limite de
# requisicao na borda, antes de a requisicao custar CPU da aplicacao.
#
# O ENDERECO E UM DUCKDNS, decidido em 29 de setembro de 2026. E gratuito e
# serve para o Tradugil sair da maquina de desenvolvimento. O TLS funciona
# igual: o Caddy pede o certificado a Let's Encrypt pelo desafio HTTP-01, que
# so precisa das portas 80 e 443 abertas e do nome resolvendo para esta
# maquina. Nao ha nada de segunda classe no certificado.
#
# O que um DuckDNS exige a mais e manter o IP atualizado. Ver
# infra/duckdns-atualiza.sh e a unidade systemd ao lado dele.
#
# Quando houver dominio proprio, mudam juntos: esta linha, o
# tradugil.cors.origens do application.yml, o manifesto da extensao (que
# precisa de versao nova na loja) e o URL_DA_API do build de release do
# Android.

tradugil.duckdns.org {

	encode gzip zstd

	# Cabecalhos de seguranca. A aplicacao nao pode contar so com o que ela
	# mesma envia: se um dia servir um arquivo estatico direto, e daqui que
	# a protecao vem.
	header {
		# UMA SEMANA, e nao um ano, enquanto o endereco for DuckDNS.
		#
		# HSTS e uma promessa que o navegador guarda mesmo depois de o site
		# sumir: durante o max-age ele se recusa a falar HTTP com aquele
		# nome. Num nome emprestado isso e diferente de um dominio proprio,
		# porque um nome DuckDNS abandonado volta para a fila e outra pessoa
		# pode registrar. Um ano de promessa presa nos navegadores sobre um
		# nome que nao e mais nosso e heranca que ninguem pediu.
		#
		# Uma semana ainda cobre o ataque que o HSTS existe para impedir (a
		# primeira visita e por HTTP, e alguem no meio a redireciona) para
		# quem usa o site com alguma regularidade. Ao trocar por dominio
		# proprio, volte para max-age=31536000.
		Strict-Transport-Security "max-age=604800; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Remove a assinatura do servidor: nao ajuda ninguem legitimo.
		-Server
	}

	# ------------------------------------------------------------------ API

	# Autenticacao tem teto proprio, e bem mais baixo. Antes ela dividia os
	# 60/min com a consulta ao dicionario, o que dava 60 tentativas de senha
	# por minuto por IP: muito para uma rota cujo uso legitimo e entrar uma
	# vez a cada 30 dias, que e a validade do refresh token.
	#
	# A ordem importa: este handle vem primeiro e o Caddy usa o mais
	# especifico, entao /api/v1/auth/* nunca cai no bloco geral abaixo.
	handle /api/v1/auth/* {
		rate_limit {
			zone autenticacao {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy api:8080
	}

	handle /api/* {
		# Limite por IP na borda. E a mitigacao de negacao de servico do
		# threat model: o /traduzir e publico e, sem teto aqui, alguem
		# automatiza consultas de termos inventados para gerar custo de IA.
		# A cota diaria da aplicacao e a segunda linha, nao a primeira.
		#
		# A aplicacao tem o proprio limitador, por classe de rota. Os dois
		# existem de proposito: este some junto com o Caddy, e defesa que
		# depende de uma peca externa estar no lugar falha em silencio.
		rate_limit {
			zone consultas {
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy api:8080
	}

	# A documentacao da API NAO e publicada. Ela descreve toda a superficie do
	# servico, o que e material de trabalho para quem desenvolve e material de
	# reconhecimento para quem ataca. A aplicacao ja a fecha por padrao
	# (tradugil.documentacao.publica); nao encaminhar daqui e a segunda tranca,
	# para o dia em que alguem ligar a primeira sem pensar.
	#
	# Para consultar em desenvolvimento:
	#     mvn spring-boot:run -Dspring-boot.run.profiles=dev
	#     http://localhost:8080/swagger-ui.html

	# --------------------------------------------------------------- Site

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# O service worker nunca pode ser cacheado: um sw.js velho preso no
		# cache do navegador deixa o usuario em uma versao antiga do site
		# indefinidamente, sem nenhuma forma de se atualizar sozinho.
		@service_worker path /sw.js /registerSW.js
		header @service_worker Cache-Control "no-cache, no-store, must-revalidate"

		# O resto do bundle tem hash no nome: pode ser cacheado para sempre.
		@com_hash path_regexp \.[0-9a-zA-Z_-]{8,}\.(js|css|woff2)$
		header @com_hash Cache-Control "public, max-age=31536000, immutable"
	}

	# ------------------------------------------------------------------- APK

	# O aplicativo Android e distribuido pelo site, e nao pela Play Store.
	#
	# O ARQUIVO NAO SAI DAQUI. Esta rota redireciona para a Release do GitHub.
	#
	# A e2-micro tem 1 GB de trafego de saida por mes, de gratuito. Um APK de
	# 15 MB gasta isso em uns 60 downloads, e depois passa a ser cobrado por
	# um arquivo que o GitHub serve sem teto. E o APK e assinado com a chave
	# que nao esta no repositorio, entao servi-lo daqui dependia de alguem
	# lembrar de copiar para o servidor a cada versao.
	#
	# O endereco curto continua valendo, que e o que importa para quem
	# instala: o link do site nao muda quando sai versao nova.
	#
	# 302, e nao 301: permanente ficaria preso no cache do navegador e do
	# proxy, e no dia em que o APK voltar a ser servido daqui, ou mudar de
	# lugar, nao haveria como desfazer.
	redir /baixar/tradugil.apk https://github.com/Everett-gi/tradugil/releases/latest/download/tradugil.apk 302

	log {
		output file /var/log/caddy/tradugil.log
		# Sem corpo de requisicao no log: o /traduzir recebe texto lido da
		# tela do usuario, e registra-lo criaria exatamente o arquivo de
		# conversas privadas que a secao 8 do documento proibe.
		format json
	}
}
